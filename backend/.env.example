# Which model provider to use: gemini (has a free tier) or claude.
# If left blank, StudyLens uses whichever provider has a key below.
LLM_PROVIDER=gemini

# --- Gemini (free tier): get a key at https://aistudio.google.com/apikey
# Note: on the free tier, Google may use your prompts to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded, rate-limited or slow:
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# --- Claude (paid, pay-as-you-go): get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
